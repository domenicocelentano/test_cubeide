*.launch

# Mantieni
!.ioc        # file di configurazione STM32CubeMX
!.cproject   # configurazione progetto STM32CubeIDE
!.project    # configurazione progetto STM32CubeIDE

# Tieni sotto controllo
Drivers/
Middlewares/
#Core/
#Inc/
#Src/
#*.ld        # file linker script (se personalizzato)

