# Ignora cartelle di build
/Debug/
/Release/

# Ignora file temporanei e di sistema IDE
.metadata/
#/.settings/

# Ignora file temporanei del sistema operativo
*.log
*.tmp
*.bak
*.swp

# Ignora file binari e oggetti
